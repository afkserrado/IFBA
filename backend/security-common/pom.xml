<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================ -->
    <!-- Identificação do projeto -->
    <!-- Módulo comum compartilhado de segurança entre microsserviços -->
    <!-- ============================ -->
    <groupId>br.edu.ifba</groupId>
    <artifactId>security-common</artifactId>
    <version>1.0.0</version>

    <!-- ============================ -->
    <!-- Propriedades do projeto -->
    <!-- Define as versões do Java e do Spring Boot -->
    <!-- ============================ -->
    <properties>
        <java.version>21</java.version>
        <spring.boot.version>4.1.0</spring.boot.version>
    </properties>

    <dependencies>

        <!-- ============================ -->
        <!-- Spring Security -->
        <!-- Fornece a infraestrutura básica de autenticação e autorização -->
        <!-- ============================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- ============================ -->
        <!-- JJWT API -->
        <!-- Fornece a API para criação e validação de tokens JWT -->
        <!-- ============================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>

        <!-- ============================ -->
        <!-- JJWT Implementation -->
        <!-- Implementação utilizada em tempo de execução -->
        <!-- ============================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================ -->
        <!-- JJWT Jackson -->
        <!-- Permite serializar e desserializar o conteúdo JSON do token -->
        <!-- ============================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================ -->
        <!-- Spring Boot Web -->
        <!-- Permite utilizar filtros Servlet e contexto web para extrair o cabeçalho Authorization -->
        <!-- ============================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

        <!-- ============================ -->
        <!-- OpenFeign -->
        <!-- Fornece o RequestInterceptor para a propagação do token JWT em chamadas entre microsserviços -->
        <!-- ============================ -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>

    </dependencies>

</project>